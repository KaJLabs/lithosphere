{
  "$schema": "https://json.schemastore.org/commitlintrc.json",
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "perf",
        "sec",
        "obs",
        "deploy",
        "dx",
        "sdk",
        "ci",
        "test",
        "docs",
        "gov",
        "chore",
        "refactor",
        "style",
        "build",
        "revert"
      ]
    ],
    "type-empty": [2, "never"],
    "type-case": [2, "always", "lower-case"],
    "subject-empty": [2, "never"],
    "scope-case": [2, "always", "lower-case"],
    "header-max-length": [2, "always", 120]
  }
}
