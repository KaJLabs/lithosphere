{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft": false,
  "prerelease": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "sec", "section": "Security" },
    { "type": "obs", "section": "Observability" },
    { "type": "deploy", "section": "Deployment" },
    { "type": "dx", "section": "Developer Experience" },
    { "type": "sdk", "section": "SDK" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "gov", "section": "Governance", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "refactor", "section": "Refactors", "hidden": true },
    { "type": "style", "section": "Styling", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple"
    }
  }
}
