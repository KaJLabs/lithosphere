{
  "name": "@lithosphere/sdk",
  "version": "0.1.0",
  "description": "Lithosphere high-level client SDK — LithoClient with retry/backoff, balance helpers, typed errors.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "lithosphere",
    "sdk",
    "web3",
    "evm",
    "blockchain",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KaJLabs/Lithosphere",
    "directory": "Makalu/packages/sdk"
  },
  "dependencies": {
    "@lithosphere/blockchain-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
