# Explorer is intentionally NOT a workspace member — it has its own
# pnpm-lock.yaml that tracks Next.js + UI deps independently from the
# api/indexer build chain. Without this flag, `pnpm install` walks up to
# Makalu/pnpm-workspace.yaml and re-resolves against the workspace lockfile,
# silently ignoring the explorer's local lockfile and any newly-added deps.
#
# Set explicitly here so both local dev (`pnpm install` in this dir) and
# CI (the "Explorer tests with coverage" step in ci.yaml) see consistent
# behaviour without needing to remember the flag.
ignore-workspace=true
