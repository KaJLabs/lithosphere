+// normalizeLITHOTestGenesisSupply makes Evmos's small synthetic integration
+// genesis compatible with LITHO's immutable one-billion-token genesis rule.
+// It never reduces supply, so an over-cap fixture continues to fail closed.
+func normalizeLITHOTestGenesisSupply(
+	evmosApp *app.Evmos,
+	genesisState types.GenesisState,
+) (types.GenesisState, error) {
+	bankGenesis := banktypes.GetGenesisStateFromAppState(evmosApp.AppCodec(), genesisState)
+	totalSupply := calculateTotalSupply(bankGenesis.Balances).AmountOf(utils.BaseDenom)
+	maximumSupply := app.LITHOMaximumSupply()
+	if totalSupply.GT(maximumSupply) {
+		return genesisState, fmt.Errorf(
+			"LITHO integration-test genesis exceeds maximum supply: maximum %s, got %s",
+			maximumSupply,
+			totalSupply,
+		)
+	}
+
+	if totalSupply.Equal(maximumSupply) {
+		return genesisState, nil
+	}
+
+	topUp := sdktypes.NewCoin(utils.BaseDenom, maximumSupply.Sub(totalSupply))
+	bankGenesis.Balances = append(bankGenesis.Balances, banktypes.Balance{
+		Address: authtypes.NewModuleAddress("litho_test_genesis_reserve").String(),
+		Coins:   sdktypes.NewCoins(topUp),
+	})
+	bankGenesis.Supply = calculateTotalSupply(bankGenesis.Balances)
+	genesisState[banktypes.ModuleName] = evmosApp.AppCodec().MustMarshalJSON(bankGenesis)
+
+	return genesisState, nil
+}
