+func (suite *KeeperTestSuite) TestSetBalanceRejectsModuleAccounts() {
+	testCases := []struct {
+		name     string
+		amountFn func(*big.Int) *big.Int
+	}{
+		{
+			name: "increase",
+			amountFn: func(current *big.Int) *big.Int {
+				return new(big.Int).Add(current, big.NewInt(1))
+			},
+		},
+		{
+			name: "decrease",
+			amountFn: func(current *big.Int) *big.Int {
+				return new(big.Int).Sub(current, big.NewInt(1))
+			},
+		},
+		{
+			name: "unchanged",
+			amountFn: func(current *big.Int) *big.Int {
+				return new(big.Int).Set(current)
+			},
+		},
+	}
+
+	for _, tc := range testCases {
+		suite.Run(tc.name, func() {
+			suite.SetupTest()
+			ctx := suite.network.GetContext()
+			moduleAddr := authtypes.NewModuleAddress(inflationtypes.ModuleName)
+			params := suite.network.App.EvmKeeper.GetParams(ctx)
+			coins := sdk.NewCoins(sdk.NewCoin(params.EvmDenom, sdkmath.NewInt(100)))
+			suite.Require().NoError(
+				suite.network.App.BankKeeper.MintCoins(ctx, inflationtypes.ModuleName, coins),
+			)
+
+			ethAddr := common.BytesToAddress(moduleAddr.Bytes())
+			before := suite.network.App.EvmKeeper.GetBalance(ctx, ethAddr)
+			err := suite.network.App.EvmKeeper.SetBalance(ctx, ethAddr, tc.amountFn(before))
+			suite.Require().Error(err)
+			suite.Require().ErrorContains(err, "is not allowed to receive funds")
+			after := suite.network.App.EvmKeeper.GetBalance(ctx, ethAddr)
+			suite.Require().Equal(before, after)
+		})
+	}
+}
+
+func (suite *KeeperTestSuite) TestSetBalanceRejectsBlockedAccountChange() {
+	suite.SetupTest()
+	ctx := suite.network.GetContext()
+	blockedAddr := common.HexToAddress(types.StakingPrecompileAddress)
+	before := suite.network.App.EvmKeeper.GetBalance(ctx, blockedAddr)
+
+	err := suite.network.App.EvmKeeper.SetBalance(ctx, blockedAddr, new(big.Int).Add(before, big.NewInt(1)))
+	suite.Require().Error(err)
+	suite.Require().ErrorContains(err, "is not allowed to receive funds")
+	after := suite.network.App.EvmKeeper.GetBalance(ctx, blockedAddr)
+	suite.Require().Equal(before, after)
+}
+
+func (suite *KeeperTestSuite) TestSetBalanceAllowsEOA() {
+	suite.SetupTest()
+	ctx := suite.network.GetContext()
+	addr := utiltx.GenerateAddress()
+	amount := big.NewInt(12345)
+
+	suite.Require().NoError(suite.network.App.EvmKeeper.SetBalance(ctx, addr, amount))
+	suite.Require().Equal(amount, suite.network.App.EvmKeeper.GetBalance(ctx, addr))
+}
