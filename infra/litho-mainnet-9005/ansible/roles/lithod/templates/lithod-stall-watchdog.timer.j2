# Run the stall watchdog every 2 minutes. Cheap (one curl to local RPC).
# With stall_sec=300 a wedge is detected and healed within ~5-7 minutes
# instead of sitting until the next 4h scheduled restart.

[Unit]
Description=Run {{ litho_service_name }} stall watchdog every {{ lithod_stall_watchdog_interval }}

[Timer]
OnBootSec={{ lithod_stall_watchdog_on_boot_sec }}
OnUnitActiveSec={{ lithod_stall_watchdog_interval }}
AccuracySec={{ lithod_stall_watchdog_accuracy_sec }}

[Install]
WantedBy=timers.target
