# ============================================================================
# Kamet Explorer Environment Configuration
# ============================================================================

# RPC Endpoints (Kamet — mainnet)
# Internal endpoints rpc-3/api-3 → kamet-sentry-04 (VPS) so the explorer reads
# the same node where transactions are submitted via rpc-3. Public endpoint
# kept as VITE_RPC_PUBLIC_URL for footer/docs display.
VITE_RPC_URL=https://rpc-3.litho.ai
VITE_REST_URL=https://api-3.litho.ai
# grpc-3.litho.ai is pending DNS and cert issuance; use the current direct endpoint
VITE_GRPC_URL=31.97.39.146:9090
VITE_EVM_RPC_URL=https://rpc-3.litho.ai
VITE_RPC_PUBLIC_URL=https://rpc-3.litho.ai
VITE_EXPLORER_WS_URL=wss://rpc-3.litho.ai/websocket

# Chain Configuration
VITE_CHAIN_ID=lithosphere_900523-2
VITE_CHAIN_NAME=Lithosphere Kamet
VITE_NETWORK_LABEL=Kamet
VITE_EVM_CHAIN_ID=900523
VITE_DENOM=LITHO
VITE_BASE_DENOM=ulitho
VITE_BECH32_PREFIX=litho
VITE_DECIMALS=18

# Application
VITE_APP_NAME=Kamet Explorer
VITE_APP_DESCRIPTION=Explore blocks, transactions, validators, addresses, contracts, and tokens on Lithosphere Kamet
VITE_EXPLORER_URL=https://kamet.litho.ai
VITE_EXPLORER_DATA_API_URL=https://kamet.litho.ai/api
VITE_STATUS_PAGE_URL=https://status.litho.ai
VITE_STATUS_API_URL=https://status.litho.ai/api/status
VITE_STATUS_METRICS_URL=https://status.litho.ai/api/metrics
VITE_DOCS_URL=https://docs.litho.ai
VITE_VALIDATOR_PORTAL_URL=https://validator.litho.ai
VITE_ECOSYSTEM_URL=https://ecosystem.litho.ai
VITE_SETUP_GUIDE_URL=https://github.com/kasrthegreat/litho-makalu-validators
VITE_FAUCET_URL=https://kamet.litho.ai/faucet
VITE_FAUCET_ASSETS_URL=https://api-3.litho.ai/faucet/assets
VITE_FAUCET_CLAIM_URL=https://api-3.litho.ai/faucet/claim
VITE_SENTRY_DSN=
VITE_SENTRY_ALLOWED_HOSTS=kamet.litho.ai,status.litho.ai
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DEBUG=false
VITE_SENTRY_RELEASE=
# Set these from the latest contracts/deployments/kamet-*.json artifact after each Kamet reset.
VITE_MULTX_BRIDGE_ADDRESS=
VITE_MULTX_API_URL=https://bridge.litho.ai
VITE_LITHO_TOKEN_ADDRESS=

# API Timeouts (milliseconds)
VITE_API_TIMEOUT=10000
VITE_BLOCK_TIME=1000
VITE_RECENT_LOOKBACK_BLOCKS=50000

# Price Override (set to a number to bypass CoinGecko, leave empty to use live price)
VITE_LITHO_PRICE_OVERRIDE=

# Privy Social Login (https://privy.io — create an app and paste the App ID here)
VITE_PRIVY_APP_ID=

# Feature Flags
VITE_ENABLE_VALIDATORS=true
VITE_ENABLE_STAKING=true
VITE_ENABLE_GOVERNANCE=true
VITE_ENABLE_MARKETS=true
VITE_ENABLE_WEB3MODAL=true
# WalletConnect Cloud project ID. Shared default (same as makalu.litho.ai);
# register your own at https://cloud.walletconnect.com if rate-limited.
VITE_WC_PROJECT_ID=84842078b09946638c03157f83405213
