NODE_ENV=production
SIGNER_PORT=9443
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_PROFILE=multx-signer
AWS_CONFIG_FILE=/run/aws/config
AWS_SDK_LOAD_CONFIG=1
AWS_EC2_METADATA_DISABLED=true
KMS_KEY_ID=REPLACE_WITH_KMS_SIGNING_KEY_ARN
KMS_EXPECTED_ADDRESS=REPLACE_WITH_CHECKSUMMED_EVM_ADDRESS
SIGNER_BEARER_TOKEN_FILE=/run/secrets/signer-bearer-token
SIGNER_POLICY_FILE=/run/config/policy.json
SIGNER_TLS_CERT_FILE=/run/tls/server.crt
SIGNER_TLS_KEY_FILE=/run/tls/server.key
SIGNER_CLIENT_CA_FILE=/run/tls/client-ca.crt
SIGNER_STATE_FILE=/var/lib/multx-signer/signed-releases.jsonl
